      "name": "Solutions",
      "description": {
        "content": "List the co-sell solutions registered with AWS Partner Central for\nyour account. Solution identifiers are referenced by `solutions` on\nopportunities.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "6197387b-f0d3-4726-b0ed-a72d62838b28",
          "name": "List co-sell solutions",
          "request": {
            "name": "List co-sell solutions",
            "description": {
              "content": "Returns the active co-sell solutions registered with AWS Partner Central for the\nauthenticated vendor.\n\nFor vendor accounts provisioned for use in a test environment, this endpoint\nreturns a fixed three-solution fixture; the `q`, `from`, `pageSize`, and\n`all` query parameters are **ignored** for these vendors and the response\nbody is the same fixture set regardless of what the client sends. Production\nvendor accounts receive vendor-specific results that honor every query\nparameter.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "solutions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "A search query to filter the solutions."
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<integer>",
                  "description": "The starting index of the solutions to return."
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "10",
                  "description": "The number of solutions to return per page (minimum 1, maximum 100, default 10)."
                },
                {
                  "disabled": false,
                  "key": "all",
                  "value": "<boolean>",
                  "description": "Set to `true` to return solutions in any status, including inactive ones.\nDefaults to `false` (only active solutions are returned)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
