{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tackle Authentication Registrations API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Registrations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Register an Order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tackle.io/v1/registrations",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Notify Tackle of order modifications or registrations (like when a submission is made on your self-hosted registration page)"
        }
      ]
    }
  ],
  "bundled": true
}