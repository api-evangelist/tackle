        {
          "id": "c54187c5-d042-4a44-879a-b8e70365f5be",
          "name": "Convert currencies",
          "request": {
            "name": "Convert currencies",
            "description": {
              "content": "Converts one or more amounts from a base currency to a target currency\nusing cached Microsoft foreign exchange rates. Row-level conversion\nerrors are returned in `results[].error` without failing the entire\nrequest.\n\nRequired RBAC action: `offers:CreateDraftOffer`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "currencies",
                "convert"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "Optional caller-provided operation ID for request tracing.",
                "key": "tackle-operation-id",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversions\": [\n    {\n      \"id\": \"<string>\",\n      \"base_currency\": \"<string>\",\n      \"target_currency\": \"<string>\",\n      \"amount\": \"<double>\"\n    }\n  ],\n  \"as_of_date\": \"<date>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
