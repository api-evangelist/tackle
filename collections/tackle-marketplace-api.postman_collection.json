        {
          "id": "921bfd0f-1f08-48a9-a3f1-562e18bd6f13",
          "name": "List Allowed Currencies",
          "request": {
            "name": "List Allowed Currencies",
            "description": {
              "content": "Returns the 3-letter ISO 4217 currency codes the calling seller may\nquote in a private offer. The seller is identified by the vendor ID\nin the bearer token; no path parameter is required.\n\n**Required RBAC permission:** `offers:CreateDraftOffer` (currency\nselection is part of the offer-creation flow).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "allowed-currencies"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET"
          },
          "response": [
            {
              "id": "8d616d3a-d40b-44cf-aa92-4d2eeef61f31",
              "name": "List of allowed currency codes.",
              "originalRequest": {
                "url": {
                  "path": [
                    "allowed-currencies"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
