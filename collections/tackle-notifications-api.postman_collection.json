          "id": "306e82da-b744-46c9-9888-fa498eaada3e",
          "name": "Create an offer notification",
          "request": {
            "name": "Create an offer notification",
            "description": {
              "content": "Creates an offer notification. Currently only buyer instruction emails\nare supported. To send buyer instructions, use `type:\nbuyer_instructions` and `channel: email`. The handler publishes through\nTackle Notification Service and marks the offer as email sent.\n\nRequired RBAC action: `offers:SendOfferInstructions`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "private-offers",
                ":id",
                "notifications"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) Tackle private offer ID."
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "Optional caller-provided operation ID for request tracing.",
                "key": "tackle-operation-id",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"<string>\",\n  \"channel\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
